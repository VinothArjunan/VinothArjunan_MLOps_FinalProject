name: CI-CD Pipeline

on:
  push:
    branches:
      - main

jobs:
  # =============================
  # JOB 1: Build & Push Images
  # =============================
  build:
    name: Build & Push to DockerHub
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Login to DockerHub
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build API Docker image
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/vinotharjunan-mlops830api:latest -f docker/Dockerfile.api .

      - name: Build UI Docker image
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/vinotharjunan-mlops830ui:latest -f docker/Dockerfile.ui .

      - name: Push API image
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/vinotharjunan-mlops830api:latest

      - name: Push UI image
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/vinotharjunan-mlops830ui:latest

  # =============================
  # JOB 2: Deploy to Kubernetes
  # =============================
  deploy:
    name: Deploy to Kubernetes
    runs-on: self-hosted
    needs: build

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup kubeconfig
        env:
          KUBECONFIG_DATA: ${{ secrets.KUBECONFIG_DATA }}
        run: |
          mkdir -p ~/.kube
          echo "$KUBECONFIG_DATA" | base64 --decode > ~/.kube/config
          chmod 600 ~/.kube/config

      - name: Debug kubeconfig
        env:
          KUBECONFIG: ~/.kube/config
        run: |
          echo "----- kubeconfig -----"
          cat ~/.kube/config
          echo "----- contexts -----"
          kubectl config get-contexts

      - name: Deploy to Kubernetes
        env:
          KUBECONFIG: ~/.kube/config
        run: |
          kubectl apply -f k8s/api-deployment.yaml
          kubectl apply -f k8s/ui-deployment.yaml


